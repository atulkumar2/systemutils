# Copy to .env and adjust to your machine. Never commit .env.
WIFI_IFACE=wlp5s0
NOTIFY_USER=your-username
LOG_FILE=/var/log/wifi_band.log
BAND_STATE_FILE=/var/tmp/wifi_last_band
COUNTER_STATE_FILE=/var/tmp/wifi_byte_counters
LOCK_FILE=/var/lock/wifi_usage.lock
USAGE_LOGGER_BIN=/usr/local/bin/wifi_usage_logger.sh
